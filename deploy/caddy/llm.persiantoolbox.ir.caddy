llm.persiantoolbox.ir {
	encode zstd gzip
	root * /srv/awesome-free-llm-apis-ir/current

	# Discover admin is locked by default. Production supplies the real user/hash
	# through the private Caddy service environment; the fallback hash has no known password.
	@discover_admin path /discover/admin /discover/admin/* /discover/api/admin /discover/api/admin/*
	basic_auth @discover_admin {
		{$DISCOVER_ADMIN_USER:discover-disabled} {$DISCOVER_ADMIN_PASSWORD_HASH:$2y$12$0Y0SCD5WgiKPezdxwF1dMuJ2mQ7GIdFF7RTmIX5sFWAVD/u8kG8uG}
	}

	# Preserve route order: dynamic endpoints must be handled before static 404s.
	route {
		handle /api/event {
			reverse_proxy 127.0.0.1:8002
		}

		handle /discover/api/* {
			reverse_proxy 127.0.0.1:8003
		}

		handle {
			try_files {path} {path}/ =404
			file_server
		}
	}

	@catalog path /catalog.json
	header @catalog Cache-Control "public, max-age=300, must-revalidate"
	@buildmeta path /build-meta.json
	header @buildmeta Cache-Control "no-store"
	@discover_page path /discover /discover/ /discover/index.html
	header @discover_page Cache-Control "no-cache, must-revalidate"
	header @discover_admin Cache-Control "no-store"
	# Asset filenames are currently stable rather than content-hashed. They must
	# revalidate so a new HTML release cannot execute stale JavaScript or CSS.
	@static path *.js *.css *.png *.svg *.webmanifest
	header @static Cache-Control "public, max-age=300, must-revalidate"
	@index path / /index.html
	header @index Cache-Control "no-cache, must-revalidate"
	@sitemap path /sitemap.xml /robots.txt /llms.txt
	header @sitemap Cache-Control "public, max-age=300, must-revalidate"
	@notfound path /404.html
	header @notfound Cache-Control "no-store"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output file /var/log/caddy/llm.persiantoolbox.ir.access.log
		format json
	}
}
